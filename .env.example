# Copy to .env and fill in. .env is gitignored. See docs/dev-setup.md.

# Supabase (PERSONAL project — not the work org). From the dashboard.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # service_role key — server-side only, never ship in the app
SUPABASE_ANON_KEY=                    # anon key — safe for the client

# For `supabase db push` (keychain login 401s; use a dashboard PAT inline)
SUPABASE_ACCESS_TOKEN=sbp_

# FX worker (D-012) — Open Exchange Rates
OXR_APP_ID=
FX_CARD_SPREAD=0.02                   # card-realistic = interbank x (1 + spread)
