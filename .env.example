# Copy to .env and fill in the blanks. .env is gitignored. See docs/dev-setup.md.

# --- Supabase (PERSONAL project gfmonmctebklltywhhzn) ---
SUPABASE_PROJECT_REF=gfmonmctebklltywhhzn
SUPABASE_URL=https://gfmonmctebklltywhhzn.supabase.co
SUPABASE_ANON_KEY=                    # Settings > API > anon key (safe for client)
SUPABASE_SERVICE_ROLE_KEY=            # Settings > API > service_role (server-only, never ship)

# For `supabase link` / `db push`:
SUPABASE_ACCESS_TOKEN=sbp_            # Account > Access Tokens (personal PAT)
SUPABASE_DB_PASSWORD=                 # Settings > Database > password (or reset it there)

# --- FX worker (D-012) — Open Exchange Rates ---
OXR_APP_ID=
FX_CARD_SPREAD=0.02                   # card-realistic = interbank x (1 + spread)

# --- Vercel (PERSONAL account) — see docs/deploy-vercel.md / memory ---
# Per-command token so the CLI never touches the global WORK session.
# Never run `vercel login` / `vercel switch`. Create at vercel.com (personal) > Settings > Tokens.
HAULIDAY_VERCEL_TOKEN=                # personal Vercel access token
HAULIDAY_VERCEL_SCOPE=danidavidchan-3724s-projects
