{
  "expo": {
    "name": "Hauliday",
    "slug": "hauliday",
    "scheme": "hauliday",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notdani404.hauliday"
    },
    "android": {
      "package": "com.notdani404.hauliday",
      "adaptiveIcon": {
        "backgroundColor": "#F8A7AC",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Hauliday scans product barcodes to look up prices. It never records or stores video."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
